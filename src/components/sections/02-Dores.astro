---
// Conteúdo: CONTENT.md §Seção 2. Ícones reais (docs/reference/MEDIA-TODO.md).
import iconRelogio from '../../assets/icons/dor-relogio.svg';
import iconTurma from '../../assets/icons/dor-turma.svg';
import iconAtencao from '../../assets/icons/dor-atencao.svg';
import iconBusca from '../../assets/icons/dor-busca.svg';
import iconQualidade from '../../assets/icons/dor-qualidade.svg';

const dores = [
  { icon: iconRelogio, forte: 'Falta de tempo', resto: 'para planejar aulas com qualidade.' },
  { icon: iconTurma, forte: 'Turma desnivelada', resto: '— alunos em ritmos diferentes ao mesmo tempo.' },
  { icon: iconAtencao, forte: 'Atenção que escapa', resto: 'entre uma atividade e outra.' },
  { icon: iconBusca, forte: 'Horas garimpando', resto: 'atividades em dezenas de sites.' },
  { icon: iconQualidade, forte: 'Material que não funciona', resto: '— bonito no PDF, vazio em sala.' },
];
---

<section class="py-[40px] md:py-[60px] bg-clube-bege">
  <div class="max-w-6xl mx-auto px-space-md">
    <h2 class="font-heading font-semibold text-[24px] md:text-[32px] text-clube-azul-escuro text-center">
      Se você sente isso no dia a dia da sala de aula...
    </h2>

    <div class="mt-space-xl grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-space-md">
      {dores.map((dor) => (
        <div class="bg-clube-branco rounded-radius-xl shadow-md p-space-md text-center">
          <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-clube-rosa/15">
            <img src={dor.icon.src} width="28" height="28" alt="" />
          </div>
          <p class="mt-space-sm font-body text-clube-azul-escuro"><strong>{dor.forte}</strong> {dor.resto}</p>
        </div>
      ))}
    </div>

    <div class="mt-space-xl bg-clube-azul-escuro rounded-radius-lg p-space-lg text-center">
      <p class="font-heading font-semibold text-xl md:text-2xl text-clube-bege">
        O <strong>Clube das Profs</strong> foi criado para resolver exatamente isso.
      </p>
      <p class="mt-space-sm font-body text-clube-azul-claro max-w-2xl mx-auto">
        Recursos prontos, lúdicos e eficazes — entregues toda semana, organizados por ano e disciplina, e validados por mais de 45 mil professoras.
      </p>
    </div>
  </div>
</section>
