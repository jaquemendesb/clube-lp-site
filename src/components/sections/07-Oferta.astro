---
// Conteúdo: CONTENT.md §Seção 7. Variante ativa: B1 (destaque na parcela) — já refletida
// na classe OFERTA-B1 da section. Variante B2 (destaque no valor total) fica documentada
// aqui pra trocar depois, se o teste B pedir.
//
// ⚠️ PENDENTE (CONTENT.md §Seção 7 / CLAUDE.md §Decisões em aberto): confirmar que
// R$ 547,00 é valor de referência real (já praticado antes), não só efeito de âncora —
// risco de "preço fantasma" pelo CDC se questionado. Não alterar a copy sem validar com a Jaque.
import CtaButton from '../ui/CtaButton.astro';
import Icon from '../ui/Icon.astro';

const CHECKOUT_URL = 'https://clubedasprofs.com.br/?add-to-cart=17307';

const itens = [
  'Centenas de atividades prontas (português, matemática, demais disciplinas)',
  'Recursos para sala de aula',
  'Projeto de Literatura e Produção Textual',
  'Projeto Descomplicando a Caligrafia',
  'Aula BNCC com material exclusivo',
  'Novos recursos toda semana',
  'Comunidade exclusiva no WhatsApp',
  'Bônus: Mini formação de Inteligência Artificial',
];

const selos: { icon: 'calendar' | 'lock' | 'zap' | 'chat'; texto: string }[] = [
  { icon: 'calendar', texto: 'Acesso por 12 meses — não é assinatura' },
  { icon: 'lock', texto: 'Pagamento seguro (PIX, boleto e cartão)' },
  { icon: 'zap', texto: 'Acesso imediato (liberado após confirmação)' },
  { icon: 'chat', texto: 'Suporte por e-mail (atendimento@clubedasprofs.com.br)' },
];
---

<section class="OFERTA-B1 relative isolate overflow-hidden py-[40px] md:py-[60px] bg-gradient-to-b from-clube-azul-escuro to-[#16152f]" id="clube-valor">
  <div class="absolute top-1/2 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-clube-amarelo/10 blur-3xl" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto px-space-md">
    <h2 data-reveal class="font-heading font-semibold text-[24px] md:text-[32px] text-clube-bege text-center">
      Você recebe tudo isso por 1 ano
    </h2>

    <ul data-reveal class="mt-space-lg grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
      {itens.map((item) => (
        <li class="font-body text-clube-azul-claro flex items-start gap-space-sm">
          <span aria-hidden="true" class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-clube-amarelo text-clube-azul-escuro">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    <div data-reveal style="--reveal-delay: 150ms" class="mt-space-xl rounded-radius-xl shadow-lg bg-gradient-to-b from-clube-branco to-clube-bege p-space-lg text-center">
      <p class="font-body text-clube-azul-escuro">
        nas condições atuais — de <span class="line-through">R$ 547,00</span> por
      </p>
      <p class="mt-space-xs font-heading font-semibold text-4xl md:text-5xl text-clube-azul-escuro">
        12x de R$ 44,70
      </p>
      <p class="font-body text-xs text-clube-azul-escuro/70">
        (compra parcelada no cartão — não é assinatura, sem cobrança mensal recorrente)
      </p>
      <p class="mt-space-xs font-body text-clube-azul-escuro">ou R$ 447,00 à vista no PIX/Boleto/Cartão</p>

      <div class="mt-space-md">
        <CtaButton variant="primary" href={CHECKOUT_URL}>Quero entrar no Clube agora</CtaButton>
      </div>

      <div class="mt-space-md flex flex-wrap justify-center gap-space-sm">
        {selos.map((selo) => (
          <span class="inline-flex items-center gap-1.5 font-body text-sm text-clube-azul-escuro">
            <Icon name={selo.icon} class="h-4 w-4 shrink-0 text-clube-rosa" />
            {selo.texto}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
