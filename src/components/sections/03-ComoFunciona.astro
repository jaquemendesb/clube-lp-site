---
// Conteúdo: CONTENT.md §Seção 3.
import Icon from '../ui/Icon.astro';

const passos = [
  {
    titulo: 'Assine uma vez',
    texto: 'Pagamento anual em até 12x. Sem cobrança surpresa e sem renovação automática — você decide se continua.',
  },
  {
    titulo: 'Acesse todo o acervo',
    texto: 'Atividades, projetos e aulas prontas — organizados por ano (1º ao 5º) e por disciplina. Tudo num só lugar.',
  },
  {
    titulo: 'Baixe e aplique',
    texto: 'Baixa o material, imprime ou usa no projetor — e vê a turma reagir já na próxima aula.',
  },
];
---

<section class="py-[40px] md:py-[60px] bg-clube-azul-claro/10">
  <div class="max-w-6xl mx-auto px-space-md">
    <div class="flex items-center justify-center gap-space-sm">
      <span class="h-[3px] w-8 rounded-full bg-clube-rosa" aria-hidden="true"></span>
      <p class="text-center font-heading font-bold text-sm uppercase tracking-[0.15em] text-clube-rosa">Como funciona</p>
      <span class="h-[3px] w-8 rounded-full bg-clube-rosa" aria-hidden="true"></span>
    </div>
    <h2 class="mt-space-sm font-heading font-semibold text-[24px] md:text-[32px] text-clube-azul-escuro text-center max-w-3xl mx-auto">
      Em <strong>3 passos simples</strong> você sai do planejamento na correria para aulas prontas com sobra de tempo.
    </h2>

    <div class="mt-space-xl grid grid-cols-1 md:grid-cols-3 gap-space-lg">
      {passos.map((passo, i) => (
        <div class="rounded-radius-xl bg-clube-branco p-space-lg text-center shadow-md motion-safe:transition-shadow motion-safe:hover:shadow-lg">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-clube-rosa font-heading font-semibold text-xl text-clube-branco">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-space-md font-heading font-bold text-xl text-clube-azul-escuro">{passo.titulo}</h3>
          <p class="mt-space-xs font-body text-sm text-clube-azul-escuro/70">{passo.texto}</p>
        </div>
      ))}
    </div>

    <div class="mt-space-xl grid grid-cols-1 sm:grid-cols-2 gap-space-md">
      <div class="flex items-start gap-space-sm rounded-radius-xl bg-clube-amarelo p-space-lg shadow-md">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-clube-branco/60">
          <Icon name="calendar" class="h-6 w-6 text-clube-azul-escuro" />
        </span>
        <p class="font-body text-clube-azul-escuro">
          <strong class="font-heading">Toda semana</strong> — novos materiais entram no Clube. Você nunca fica sem opção nova para a próxima aula.
        </p>
      </div>
      <div class="flex items-start gap-space-sm rounded-radius-xl bg-clube-azul-escuro p-space-lg shadow-md">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-clube-branco/10">
          <Icon name="chat" class="h-6 w-6 text-clube-bege" />
        </span>
        <p class="font-body text-clube-azul-claro">
          <strong class="font-heading text-clube-bege">Comunidade WhatsApp</strong> — canal de avisos: novidades e atualizações do Clube direto no seu WhatsApp, em primeira mão.
        </p>
      </div>
    </div>
  </div>
</section>
